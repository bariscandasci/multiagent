# Sadece kişisel / özel ağ (Tailscale veya localhost). Genel internete port açılmaz.
# Canlı sunucuda LLM_PROVIDER=gemini yapın.
# Zorunlu: GEMINI_API_KEY veya GEMINI_API_KEYS, GEMINI_FALLBACK_MODEL,
# LLM_RPM, LLM_FALLBACK_RPM, ADMIN_USERNAME, ADMIN_PASSWORD.
# ADMIN_USERNAME ve ADMIN_PASSWORD canlı kurulumda ikisi birden dolu olmalıdır.
# Biri boşsa kimlik doğrulama kapalı kalır; VPS'te bu haliyle çalıştırmayın.
LLM_PROVIDER=openai

# OpenAI veya OpenAI uyumlu herhangi bir uç (vLLM, yerel ağ geçidi vb.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gemini'nin OpenAI uyumlu ucu. LLM_PROVIDER=gemini iken kullanılır.
GEMINI_API_KEY=
# Birden fazla anahtar virgülle yazılırsa her istek sıradaki anahtarı kullanır.
# Doluysa GEMINI_API_KEY yerine bu liste geçerlidir.
GEMINI_API_KEYS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash
# Ana model hata verince aynı sıcaklıkla denenen yedek. Boş bırakılırsa yedek kapalıdır.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Gizli GitHub depoları için. Boşsa yalnız herkese açık depolar okunur.
GITHUB_TOKEN=

# İsteğe bağlı. LLM_RPM, dakikadaki istek tavanıdır (gemini-3.8-flash ücretsiz katmanı 5'tir).
# Yedek modelin kotası ayrıdır; ana modelin kuyruğunda beklemez.
LLM_TEMPERATURE=0
LLM_TIMEOUT=45
LLM_RPM=4
LLM_FALLBACK_RPM=15

# Canlı kurulum kilidi. İkisi de dolu olmadan özel ağda bile servisi açmayın.
# GET /api/health ve GET /robots.txt bu kimliği istemez; diğer her uç ister.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Dinleme adresi. Varsayılan 127.0.0.1 yalnız bu makinedir.
# Tailscale IPv4 adresiniz (tailscale ip -4) yazılırsa o arayüz de açılır.
# 0.0.0.0 ve genel internet adresleri reddedilir.
BIND_IP=127.0.0.1

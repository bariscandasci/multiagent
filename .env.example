# openai | gemini
# Anahtar boşsa sistem LLM çağırmaz; departman ajanları mock araçlarla yanıtlar.
LLM_PROVIDER=openai

# OpenAI veya OpenAI uyumlu herhangi bir uç (vLLM, yerel ağ geçidi vb.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gemini'nin OpenAI uyumlu ucu. LLM_PROVIDER=gemini iken kullanılır.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# İsteğe bağlı
LLM_TEMPERATURE=0
LLM_TIMEOUT=45
